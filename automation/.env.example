# PostgreSQL direct/session-pooler URL. Do not use a browser publishable key here.
DATABASE_URL=postgresql+psycopg://postgres:password@db.example.supabase.co:5432/postgres
FANHEAT_INTERNAL_API_KEY=replace-with-a-long-random-secret
COLLECTOR_ADMIN_USER=fanheat
COLLECTOR_ADMIN_PASSWORD=replace-with-a-strong-admin-password

YOUTUBE_API_KEY=
X_BEARER_TOKEN=
NEWS_API_KEY=
NEWS_RSS_FEEDS=https://www.soompi.com/feed

OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://host.docker.internal:11434
AUTO_APPROVE_LOW_RISK=true
COMMENT_MIN_DELAY_MINUTES=5
COMMENT_MAX_DELAY_MINUTES=30
N8N_ENCRYPTION_KEY=replace-with-another-long-random-secret
N8N_USER=fanheat
N8N_PASSWORD=replace-with-a-strong-password
# n8n Settings > API에서 생성합니다. 관리자 하단 워크플로 상태 표시에만 사용됩니다.
N8N_API_KEY=
TZ=Asia/Seoul
