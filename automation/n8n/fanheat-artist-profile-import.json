    {"parameters": {"method": "POST", "url": "=http://collector-api:8080/admin/api/artist-imports/{{ $('Validate Artist Request').item.json.job_id }}/status", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "X-FANHEAT-API-KEY", "value": "={{ $env.FANHEAT_INTERNAL_API_KEY }}"}]}, "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ status: 'needs_attention', stage: '공식 아티스트 확인 필요', progress: 20, collected_count: 0, logs: $json.logs || [], message: '아티스트 이름만으로 공식 채널을 안전하게 확정하지 못했습니다.' }) }}", "options": {"timeout": 30000}}, "id": "request-source-confirmation", "name": "Request Source Confirmation", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1200, 140]},
