    {"parameters": {"method": "POST", "url": "http://collector-api:8080/v1/artists/discover/sync", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "X-FANHEAT-API-KEY", "value": "={{ $env.FANHEAT_INTERNAL_API_KEY }}"}]}, "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify($('Validate Artist Request').item.json) }}", "options": {"timeout": 120000}}, "id": "discover-official-channels", "name": "Discover Official Channels", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [720, 0]},
