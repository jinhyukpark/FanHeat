{
  "id":"FhXAdminPipe2026","name":"FANHEAT Google Drive X import to AI drafts","active":true,"settings":{"executionOrder":"v1"},
  "nodes":[
    {"parameters":{"httpMethod":"POST","path":"fanheat-x-pipeline","responseMode":"onReceived","options":{}},"id":"x-admin-webhook","name":"X Drive Pipeline Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[0,0],"webhookId":"fanheat-x-pipeline"},
    {"parameters":{"jsCode":"const headers=$json.headers??{}; if(headers['x-fanheat-automation-key']!==$env.FANHEAT_INTERNAL_API_KEY) throw new Error('invalid automation key'); const body=$json.body??$json; const collection_date=body.collection_date||$now.setZone('Asia/Seoul').toFormat('yyyy-MM-dd'); if(!/^\\d{4}-\\d{2}-\\d{2}$/.test(collection_date)) throw new Error('collection_date must be YYYY-MM-DD'); return [{json:{collection_date,sheet_name:`FANHEAT_X_KPOP_후보_${collection_date}`,create_drafts:body.create_drafts!==false,folder_query:`name='${collection_date}' and mimeType='application/vnd.google-apps.folder' and trashed=false`}}];"},"id":"prepare-drive","name":"Prepare Drive Request","type":"n8n-nodes-base.code","typeVersion":2,"position":[220,0]},
    {"parameters":{"authentication":"predefinedCredentialType","nodeCredentialType":"googleDriveOAuth2Api","url":"https://www.googleapis.com/drive/v3/files","sendQuery":true,"queryParameters":{"parameters":[{"name":"q","value":"={{ $json.folder_query }}"},{"name":"fields","value":"files(id,name,parents,modifiedTime)"},{"name":"pageSize","value":"100"},{"name":"spaces","value":"drive"},{"name":"includeItemsFromAllDrives","value":"true"},{"name":"supportsAllDrives","value":"true"}]},"options":{}},"id":"find-date-folder","name":"Find Date Folder","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[460,0],"credentials":{"googleDriveOAuth2Api":{"id":"zOTAPyrDY0TidQI9","name":"Google Drive account"}}},
    {"parameters":{"jsCode":"const files=$json.files||[]; if(!files.length) throw new Error(`Google Drive date folder not found: ${$('Prepare Drive Request').first().json.collection_date}`); files.sort((a,b)=>String(b.modifiedTime||'').localeCompare(String(a.modifiedTime||''))); const folder=files[0],sheet_name=$('Prepare Drive Request').first().json.sheet_name; return [{json:{folder_id:folder.id,sheet_name,sheet_query:`name='${sheet_name}' and '${folder.id}' in parents and mimeType='application/vnd.google-apps.spreadsheet' and trashed=false`}}];"},"id":"select-folder","name":"Select Date Folder","type":"n8n-nodes-base.code","typeVersion":2,"position":[700,0]},
    {"parameters":{"authentication":"predefinedCredentialType","nodeCredentialType":"googleDriveOAuth2Api","url":"https://www.googleapis.com/drive/v3/files","sendQuery":true,"queryParameters":{"parameters":[{"name":"q","value":"={{ $json.sheet_query }}"},{"name":"fields","value":"files(id,name,modifiedTime,webViewLink)"},{"name":"pageSize","value":"10"},{"name":"includeItemsFromAllDrives","value":"true"},{"name":"supportsAllDrives","value":"true"}]},"options":{}},"id":"find-sheet","name":"Find Candidate Sheet","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[940,0],"credentials":{"googleDriveOAuth2Api":{"id":"zOTAPyrDY0TidQI9","name":"Google Drive account"}}},
    {"parameters":{"jsCode":"const files=$json.files||[]; if(!files.length) throw new Error(`Google Sheet not found: ${$('Prepare Drive Request').first().json.sheet_name}`); files.sort((a,b)=>String(b.modifiedTime||'').localeCompare(String(a.modifiedTime||''))); return [{json:{file_id:files[0].id,sheet_name:files[0].name}}];"},"id":"select-sheet","name":"Select Candidate Sheet","type":"n8n-nodes-base.code","typeVersion":2,"position":[1180,0]},
    {"parameters":{"authentication":"predefinedCredentialType","nodeCredentialType":"googleDriveOAuth2Api","url":"=https://www.googleapis.com/drive/v3/files/{{ $json.file_id }}/export","sendQuery":true,"queryParameters":{"parameters":[{"name":"mimeType","value":"text/csv"}]},"options":{"response":{"response":{"responseFormat":"file","outputPropertyName":"data"}}}},"id":"export-sheet","name":"Export Sheet CSV","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1420,0],"credentials":{"googleDriveOAuth2Api":{"id":"zOTAPyrDY0TidQI9","name":"Google Drive account"}}},
    {"parameters":{"operation":"csv","binaryPropertyName":"data","options":{"headerRow":true}},"id":"extract-csv","name":"Extract X Candidate Rows","type":"n8n-nodes-base.extractFromFile","typeVersion":1,"position":[1660,0]},
    {"parameters":{"jsCode":"const rows=$input.all().map(item=>item.json).filter(row=>Object.values(row).some(value=>String(value??'').trim())); if(!rows.length) throw new Error('Google Sheet contains no X candidate rows'); const request=$('Prepare Drive Request').first().json; return [{json:{collection_date:request.collection_date,sheet_name:request.sheet_name,create_drafts:request.create_drafts,rows}}];"},"id":"bundle-rows","name":"Bundle X Import Rows","type":"n8n-nodes-base.code","typeVersion":2,"position":[1900,0]},
    {"parameters":{"method":"POST","url":"http://collector-api:8080/v1/imports/x/google-drive","sendHeaders":true,"headerParameters":{"parameters":[{"name":"X-FANHEAT-API-KEY","value":"={{ $env.FANHEAT_INTERNAL_API_KEY }}"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({collection_date:$json.collection_date,sheet_name:$json.sheet_name,rows:$json.rows}) }}","options":{"timeout":120000}},"id":"import-x-rows","name":"Import X Posts","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2140,0]},
    {"parameters":{"jsCode":"if(!$('Prepare Drive Request').first().json.create_drafts) return []; return [{json:{collected:Number($json.collected)||0}}];"},"id":"draft-gate","name":"Continue When AI Requested","type":"n8n-nodes-base.code","typeVersion":2,"position":[2380,0]},
    {"parameters":{"method":"POST","url":"http://ai-worker:8090/v1/pipeline/run","sendHeaders":true,"headerParameters":{"parameters":[{"name":"X-FANHEAT-API-KEY","value":"={{ $env.FANHEAT_INTERNAL_API_KEY }}"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({limit:Math.min(Math.max(Number($json.collected)||1,1),50),create_drafts:true,source:'x',priority:'manual'}) }}","options":{"timeout":600000}},"id":"generate-x-drafts","name":"Generate X AI Drafts","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2620,0]}
