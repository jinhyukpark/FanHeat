APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/fanheat
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=120
PIPELINE_BATCH_SIZE=5
PROMPT_VERSION=fanheat-v1
INTERNAL_API_KEY=replace-with-a-long-random-secret
AUTO_APPROVE_LOW_RISK=false
COMMENT_MIN_DELAY_MINUTES=5
COMMENT_MAX_DELAY_MINUTES=30
